# Copy this file to .env for local testing
# On HuggingFace Spaces, set these in:
#   Space Settings → Repository Secrets  (NOT in this file)

# ── Required ──────────────────────────────────────────────
BOT_TOKEN=8737388534:AAH3N2kqtD6HjVQHnpE4s5pEcZPcoq63LZA

# Public URL of your HuggingFace Space (no trailing slash)
# e.g. https://YIFER-tarmaber-bot.hf.space
WEBHOOK_URL=https://YOUR_HF_USERNAME-tarmaber-bot.hf.space

# HuggingFace model repo containing your fine-tuned model
HF_REPO_ID=YIFER/amharic-hate-speech
HF_TOKEN=YOUR_HUGGINGFACE_READ_TOKEN

# ── Optional ──────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.70

# When running locally (python bot.py), the bot uses polling
# and doesn't need WEBHOOK_URL or API_URL.
# API_URL defaults to http://localhost:7860/predict
API_URL=http://localhost:7860/predict
